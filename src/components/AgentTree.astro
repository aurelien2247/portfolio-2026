---
// L'arbre d'agents interactif. Le balisage pose le décor ; src/scripts/agent-tree/ fait tout le reste.
import { aboutDemo, getTopics } from "../data/content";
import { ui as uis, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = uis[lang];
// Le contenu de l'arbre, dans la langue de la page, posé dans la page en JSON : le JavaScript
// (le même pour / et /en/) ne transporte ainsi aucun texte, ni français ni anglais.
// « < » est échappé pour qu'un texte ne puisse pas fermer la balise <script>.
const data = JSON.stringify({ topics: getTopics(lang), about: aboutDemo(lang) }).replace(
  /</g,
  "\\u003c",
);
---

<section class="agent-tree" id="tree" aria-label={ui.treeLabel}>
  <p class="hint">
    <span>{ui.hint}</span>
    <svg viewBox="0 0 40 30" aria-hidden="true">
      <path d="M3 4 C 16 4, 26 10, 28 24 M21 18 L28 25 L34 17"></path>
    </svg>
  </p>
  <div class="chips" data-chips></div>
  <div class="play">
    <div class="col">
      <div class="stage box">
        <svg viewBox="0 0 1000 580" aria-hidden="true">
          <defs>
            <pattern id="mariniere" width="10" height="9" patternUnits="userSpaceOnUse">
              <rect width="10" height="9" fill="#F6F6F2"></rect>
              <rect y="5" width="10" height="4" style="fill: var(--navy)"></rect>
            </pattern>
          </defs>
          <g data-layer="edges"></g>
          <g data-layer="packets"></g>
          <g data-layer="nodes"></g>
          <g data-layer="bubbles"></g>
        </svg>
        <div class="score">
          {ui.score} <b data-score>0</b>/5
        </div>
      </div>
      <!-- Un journal en lecture seule : rien ne doit laisser croire qu'on peut y écrire. -->
      <section class="trace box" aria-label={ui.traceLabel}>
        <span class="tab">{ui.traceTab}</span>
        <ol data-log>
          <li>{ui.traceReady}</li>
        </ol>
      </section>
    </div>
    <div class="side">
      <article class="answer box" data-answer aria-live="polite">
        <span class="tab">{ui.answerTab}</span>
        <div class="answer-body"></div>
      </article>
    </div>
  </div>

  <!-- La fiche projet en grand, remplie par src/scripts/agent-tree/projects.ts -->
  <dialog
    class="project-modal box"
    data-project
    aria-labelledby="project-title"
    style="--who: var(--c-projets)"
  >
    <span class="tab"></span>
    <button class="btn close" type="button" data-close>
      {ui.close}
    </button>
    <div class="inner">
      <div class="screen" data-screen></div>
      <div class="sheet">
        <h2 id="project-title"></h2>
        <p class="context"></p>
        <div class="text"></div>
        <div class="group" data-stack>
          <p class="label">{ui.stackLabel}</p>
          <div class="tags"></div>
        </div>
        <div class="group" data-skills>
          <p class="label">{ui.skillsLabel}</p>
          <div class="tags"></div>
        </div>
        <a class="repo" data-repo target="_blank" rel="noopener">
          {ui.repo}
        </a>
        <nav aria-label={ui.otherProjects}>
          <button class="btn" type="button" data-prev>
            {ui.prev}
          </button>
          <button class="btn" type="button" data-next>
            {ui.next}
          </button>
        </nav>
      </div>
    </div>
  </dialog>
</section>

<script type="application/json" id="tree-data" set:html={data} />
<script>
  import { initAgentTree } from "../scripts/agent-tree/engine";
  import type { Topic } from "../data/agents";

  const tree = document.getElementById("tree")!;
  const data: { topics: Topic[]; about: string } = JSON.parse(
    document.getElementById("tree-data")!.textContent!,
  );
  initAgentTree(tree, data.topics, data.about);
</script>

<!-- Global : les éléments SVG sont créés par le script, les styles scopés d'Astro ne les atteindraient pas. -->
<style is:global>
  .agent-tree {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* La consigne, manuscrite, avec une flèche vers les pastilles */
  .agent-tree .hint {
    margin: 0 0 6px 6px;
    font: 22px/1 var(--f-hand);
    color: var(--accent);
    display: flex;
    align-items: flex-end;
    gap: 6px;
    transform: rotate(-1.5deg);
  }
  /* Le texte un peu plus haut que la flèche, qui descend vers les pastilles */
  .agent-tree .hint span {
    transform: translateY(-8px);
  }
  .agent-tree .hint svg {
    width: 34px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: -6px;
  }

  /* Pastilles de sujets : chacune dans la couleur de son agent, pour qu'on voie que ce sont des boutons */
  .agent-tree .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .agent-tree .chip {
    font: 500 15px/1.2 var(--f-ui);
    color: var(--fg);
    background: color-mix(in srgb, var(--who) 16%, var(--card));
    border: var(--bw) solid var(--who);
    border-radius: 12px 15px 11px 14px;
    padding: 7px 14px 7px 8px;
    min-height: 44px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition:
      transform 0.12s,
      background-color 0.15s;
  }
  .agent-tree .chip svg {
    flex: none;
    width: 30px;
    height: 26px;
  }
  .agent-tree .chip:nth-child(odd) {
    transform: rotate(-0.6deg);
  }
  .agent-tree .chip:nth-child(even) {
    transform: rotate(0.5deg);
  }
  .agent-tree .chip:hover:not(:disabled) {
    transform: translateY(-2px) rotate(-1deg);
  }
  .agent-tree .chip:active:not(:disabled) {
    transform: translateY(1px);
  }
  .agent-tree .chip[aria-pressed="true"] {
    background: var(--who);
    color: var(--who-ink, var(--ink));
  }
  .agent-tree .chip:disabled {
    cursor: progress;
  }
  .agent-tree .chip:disabled:not([aria-pressed="true"]) {
    opacity: 0.55;
  }

  /* Le « ? » en autocollant après les pastilles, et sa bulle */
  .agent-tree .about {
    position: relative;
    align-self: center;
  }
  .agent-tree .about button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: var(--bw) solid var(--frame);
    background: var(--accent);
    color: var(--ink);
    font: 700 20px/1 var(--f-hand);
    cursor: help;
    transform: rotate(-8deg);
    transition: transform 0.12s;
  }
  .agent-tree .about button:hover,
  .agent-tree .about button[aria-expanded="true"] {
    transform: rotate(4deg) scale(1.06);
  }
  /* Au-dessus du « ? », centrée ; --dx la décale pour qu'elle ne sorte pas de l'écran (calculé en JS).
     Fermée, elle n'existe pas dans la mise en page (sinon elle déborderait de l'écran sur téléphone). */
  .agent-tree .about-tip {
    display: none;
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 5;
    width: min(300px, calc(100vw - 32px));
    font: 17px/1.3 var(--f-hand);
    color: var(--fg);
    background: var(--card);
    border: var(--bw) solid var(--frame);
    border-radius: 12px 15px 11px 14px;
    padding: 10px 14px;
    transform: translateX(calc(-50% + var(--dx, 0px))) rotate(-1deg);
  }
  .agent-tree .about button[aria-expanded="true"] + .about-tip {
    display: block;
  }

  /* Mise en page : scène + trace à gauche, réponse à droite */
  .agent-tree .play {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 22px;
    container-type: inline-size;
    /* Les deux colonnes ont la même hauteur : la réponse descend jusqu'au bas de la trace */
    align-items: stretch;
  }
  /* Environ 60/40 sur ordinateur : la réponse a la place de respirer et l'arbre, moins haut, tient sur l'écran.
     En dessous de ~960px, la réponse passe sous l'arbre. */
  .agent-tree .col {
    flex: 1.6 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .agent-tree .side {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .agent-tree .side .answer {
    flex: 1;
  }
  /* Côte à côte (560 + 380 + 22px d'écart) : la réponse prend exactement la hauteur de l'arbre + trace,
     sans jamais la pousser. Si son contenu dépasse (une description ouverte), c'est l'intérieur qui défile. */
  @container (min-width: 962px) {
    .agent-tree .side {
      position: relative;
    }
    .agent-tree .side .answer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
    }
    .agent-tree .answer-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--edge) transparent;
    }
  }
  .agent-tree .stage {
    overflow: hidden;
    padding-top: var(--stage-top, 0px);
    background: var(--stage);
  }
  /* Sur téléphone, la scène est petite : on descend l'arbre sous le compteur, qui cachait l'orchestrateur */
  @media (max-width: 760px) {
    .agent-tree .stage {
      --stage-top: 34px;
    }
  }
  /* Ciblé sur la scène : les mini-têtes des pastilles sont aussi des <svg> et doivent garder leur taille. */
  .agent-tree .stage > svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: manipulation;
  }
  .agent-tree .score {
    position: absolute;
    top: 12px;
    left: 12px;
    font: 500 12px/1 var(--f-mono);
    color: var(--ink);
    background: var(--accent);
    border: 2px solid var(--frame);
    border-radius: 7px 9px 6px 8px;
    padding: 6px 10px;
    transform: rotate(-2deg);
    font-variant-numeric: tabular-nums;
  }
  .agent-tree .score b {
    font-weight: 700;
  }

  /* Dessin SVG */
  .agent-tree .edge {
    fill: none;
    stroke: var(--edge);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .agent-tree .edge.on {
    stroke: var(--fg);
    stroke-dasharray: 5 6;
    animation: edge-flow 0.45s linear infinite;
  }
  @keyframes edge-flow {
    to {
      stroke-dashoffset: -22;
    }
  }
  .agent-tree .agent {
    cursor: pointer;
  }
  .agent-tree .agent.sub {
    cursor: default;
  }
  .agent-tree .ol {
    stroke: var(--outline);
    stroke-width: 2.2;
  }
  .agent-tree .ol.thin {
    stroke-width: 1.5;
  }
  .agent-tree .legs {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .agent-tree .shadow {
    fill: var(--fg);
    opacity: 0.1;
  }
  .agent-tree .eye {
    fill: #fff;
    stroke: #15181c;
    stroke-width: 1.5;
  }
  .agent-tree .pupil {
    fill: #15181c;
  }
  .agent-tree .mouth {
    fill: none;
    stroke: #15181c;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .agent-tree .headset {
    fill: none;
    stroke: var(--outline);
    stroke-width: 3.2;
    stroke-linecap: round;
  }
  .agent-tree .earcup {
    fill: var(--fg);
  }
  .agent-tree .hair-ol {
    fill: var(--hair);
    stroke: var(--outline);
    stroke-width: 2.2;
  }
  .agent-tree .hair {
    fill: var(--hair);
  }
  .agent-tree .pending {
    fill: var(--accent);
  }
  .agent-tree .done-badge {
    fill: var(--c-stack);
  }
  .agent-tree .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Les agents sont cliquables */
  .agent-tree .agent.clickable {
    cursor: pointer;
  }
  .agent-tree .label {
    font: 500 14px var(--f-mono);
    fill: var(--fg);
    text-anchor: middle;
  }
  .agent-tree .status {
    font: 12px var(--f-mono);
    fill: var(--muted);
    text-anchor: middle;
  }
  .agent-tree .sub .label {
    font-size: 13px;
  }
  .agent-tree .sub .status {
    font-size: 11px;
  }
  .agent-tree .bubble rect,
  .agent-tree .bubble path {
    fill: var(--card);
    stroke: var(--outline);
    stroke-width: 2;
  }
  .agent-tree .bubble text {
    font: 19px var(--f-hand);
    fill: var(--fg);
  }
  .agent-tree .packet rect {
    stroke: var(--outline);
    stroke-width: 1.8;
  }

  /* Réponse : prend la couleur de l'agent qui répond (--who) */
  .agent-tree .answer-body {
    padding: 26px 22px 16px;
  }
  .agent-tree .answer h2 {
    margin: 0 0 6px;
    font-weight: 800;
    font-size: 27px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-decoration: underline 8px var(--who, var(--accent));
    text-underline-offset: -1px;
    text-decoration-skip-ink: none;
  }
  .agent-tree .answer .by {
    margin: 0 0 10px;
    font: 12px/1.5 var(--f-mono);
    color: var(--muted);
  }
  .agent-tree .answer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .agent-tree .answer ul > li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 14px;
    border-left: 3px solid var(--who, var(--frame));
    animation: answer-rise 0.35s ease-out both;
  }
  .agent-tree .answer ul > li strong {
    font-weight: 700;
  }
  .agent-tree .answer ul > li > span {
    color: var(--muted);
    font-size: 15px;
  }
  .agent-tree .answer ul > li > span strong {
    color: var(--fg);
    font-weight: 500;
  }
  /* Réponse « Ma stack » : les logos des technos, comme dans les fiches projet */
  .agent-tree .answer .techs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: 6px;
  }
  .agent-tree .answer .tech img {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 7px;
  }
  .agent-tree .answer .chip-tag {
    font: 500 12px/1 var(--f-mono);
    background: color-mix(in srgb, var(--who) 22%, var(--card));
    border: 2px solid var(--frame);
    border-radius: 6px 8px 5px 7px;
    padding: 6px 9px 5px;
  }
  .agent-tree .answer p {
    margin: 0 0 12px;
    max-width: 62ch;
  }
  .agent-tree .answer a {
    color: var(--fg);
    text-decoration-thickness: 2px;
  }
  /* Réponse en « git log » : du plus récent (HEAD) au premier commit */
  .agent-tree .answer .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .agent-tree .answer .commit {
    position: relative;
    padding: 0 0 4px 40px;
    animation: answer-rise 0.35s ease-out both;
  }
  .agent-tree .answer .commit:last-child {
    padding-bottom: 0;
  }
  /* La branche : un trait continu qui relie les nœuds */
  .agent-tree .answer .commit::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--who);
  }
  .agent-tree .answer .commit:first-child::before {
    top: 29px;
  }
  .agent-tree .answer .commit:last-child::before {
    bottom: auto;
    height: 29px;
  }
  .agent-tree .answer .commit:only-child::before {
    display: none;
  }
  .agent-tree .answer .node {
    position: absolute;
    left: 4px;
    top: 18px;
    width: 22px;
    height: 22px;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--card);
    border: var(--bw) solid var(--frame);
  }
  .agent-tree .answer .commit:first-child .node {
    background: var(--who);
  }
  /* Chaque formation est un accordéon : fermé par défaut, un seul ouvert à la fois */
  .agent-tree .answer summary {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 10px 13px 9px 12px;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.15s;
  }
  .agent-tree .answer summary::-webkit-details-marker {
    display: none;
  }
  .agent-tree .answer summary:hover,
  .agent-tree .answer details[open] summary {
    background: color-mix(in srgb, var(--who) 16%, var(--card));
  }
  .agent-tree .answer .toggle {
    flex: none;
    align-self: center;
    margin-left: auto;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    font: 700 16px/1 var(--f-mono);
    border: 2px solid var(--frame);
    border-radius: 7px 9px 6px 8px;
    background: var(--card);
  }
  .agent-tree .answer .toggle::before {
    content: "+";
  }
  .agent-tree .answer details[open] .toggle::before {
    content: "−";
  }
  .agent-tree .answer details > :not(summary) {
    margin-left: 8px;
    margin-right: 8px;
  }
  .agent-tree .answer .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 3px;
    font: 500 12px/1 var(--f-mono);
  }
  .agent-tree .answer .when {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .agent-tree .answer .badge {
    border: 2px solid var(--frame);
    border-radius: 5px 6px 4px 6px;
    padding: 3px 6px 2px;
    background: var(--accent);
    color: var(--ink);
  }
  .agent-tree .answer .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .agent-tree .answer .who strong {
    display: block;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.15;
  }
  .agent-tree .answer .place {
    display: block;
    font-size: 14px;
    line-height: 1.3;
    color: var(--muted);
  }
  /* Le logo en petit autocollant */
  .agent-tree .answer .logo {
    flex: none;
    width: 46px;
    height: 38px;
    box-sizing: border-box;
    padding: 4px;
    object-fit: contain;
    background: var(--sticker);
    border: 2px solid var(--frame);
    border-radius: 8px 10px 7px 9px;
    margin-top: 4px;
  }
  .agent-tree .answer .text {
    margin-top: 6px;
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.4;
  }
  .agent-tree .answer .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 4px;
  }
  .agent-tree .answer .tags span {
    font: 500 12px/1 var(--f-mono);
    color: var(--fg);
    background: color-mix(in srgb, var(--who) 22%, var(--card));
    border: 2px solid var(--frame);
    border-radius: 6px 8px 5px 7px;
    padding: 5px 8px 4px;
  }
  /* Sommaire des projets : une ligne-bouton par projet, qui ouvre la fiche en grand */
  .agent-tree .answer .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .agent-tree .answer .project {
    animation: answer-rise 0.35s ease-out both;
  }
  .agent-tree .answer .project button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    text-align: left;
    font: inherit;
    color: var(--fg);
    background: color-mix(in srgb, var(--who) 10%, var(--card));
    border: var(--bw) solid var(--frame);
    border-radius: 10px 13px 9px 12px;
    cursor: pointer;
    transition:
      transform 0.12s,
      background-color 0.15s;
  }
  .agent-tree .answer .project button:hover {
    background: color-mix(in srgb, var(--who) 22%, var(--card));
    transform: translate(-1px, -2px) rotate(-0.4deg);
  }
  /* Le logo de l'entreprise, en pastille ronde qu'il remplit entièrement (versions recadrées dans src/assets/logo-*) */
  .agent-tree .answer .project .logo {
    width: 50px;
    height: 50px;
    margin-top: 0;
    padding: 0;
    object-fit: cover;
    border-radius: 50%;
  }
  .agent-tree .answer .project .go {
    flex: none;
    margin-left: auto;
    font: 700 12px/1 var(--f-mono);
    color: var(--ink);
    background: var(--who);
    border: 2px solid var(--frame);
    border-radius: 6px 8px 5px 7px;
    padding: 6px 8px 5px;
  }

  /* La fiche projet : une grande boîte dessinée par-dessus la page */
  /* position: fixed, sinon .box (relative) l'emporte sur le style natif du <dialog> */
  .agent-tree .project-modal {
    position: fixed;
    width: min(1240px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    color: var(--fg);
    background: var(--card);
    overflow: visible;
  }
  .agent-tree .project-modal::backdrop {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
  }
  /* Au-dessus de l'écran, qui couvre toute la partie gauche */
  .agent-tree .project-modal .tab,
  .agent-tree .project-modal .close {
    z-index: 2;
  }
  .agent-tree .project-modal .close {
    position: absolute;
    top: -16px;
    right: 16px;
    min-height: 0;
    padding: 8px 12px;
    background: var(--accent);
    color: var(--ink);
    transform: rotate(2deg);
  }
  .agent-tree .project-modal .inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }
  /* L'écran : émulation, captures ou case vide */
  .agent-tree .project-modal .screen {
    position: relative;
    min-height: 380px;
