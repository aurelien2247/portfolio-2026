---
// L'arbre d'agents interactif. Le balisage pose le décor ; src/scripts/agent-tree/ fait tout le reste.
---

<section
  class="agent-tree"
  id="tree"
  aria-label="Démo : mes agents répondent à tes questions"
  hidden
>
  <p class="hint">
    Pose une question à mes agents.
    <span>Chacun découpe le travail, le confie à ses sous-agents et me renvoie le résultat.</span>
  </p>
  <div class="chips" data-chips></div>
  <div class="play">
    <div class="stage">
      <svg viewBox="0 0 1000 580" aria-hidden="true">
        <defs>
          <pattern id="grid" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle class="dot" cx="11" cy="11" r="1.3"></circle>
          </pattern>
          <pattern id="mariniere" width="10" height="9" patternUnits="userSpaceOnUse">
            <rect width="10" height="9" fill="#F6F6F2"></rect>
            <rect y="5" width="10" height="4" style="fill: var(--navy)"></rect>
          </pattern>
        </defs>
        <rect width="1000" height="580" fill="url(#grid)"></rect>
        <g data-layer="edges"></g>
        <g data-layer="packets"></g>
        <g data-layer="nodes"></g>
        <g data-layer="bubbles"></g>
      </svg>
      <canvas></canvas>
      <div class="score">
        agents consultés <b data-score>0</b>/5
      </div>
    </div>
    <div class="side">
      <article class="answer" data-answer aria-live="polite">
        <h2>Salut !</h2>
        <p class="by">orchestrateur · en attente</p>
        <p>
          Pose une question : je la confie à l'agent qui connaît le sujet. Il la découpe en
          sous-tâches, lance un sous-agent par tâche, rassemble les résultats et me les renvoie.
        </p>
        <p>Choisis une question au-dessus, ou clique sur un agent.</p>
      </article>
      <section class="trace" aria-label="Trace d'orchestration">
        <h3>Trace</h3>
        <ol data-log>
          <li>orchestrateur prêt · 5 agents en veille</li>
        </ol>
      </section>
      <p class="note">
        Démo animée : les réponses sont écrites par moi. Le vrai système multi-agents, lui, tourne à
        la DGFiP.
      </p>
    </div>
  </div>
</section>

<script>
  import { initAgentTree } from "../scripts/agent-tree/engine";
  import { topics } from "../data/agents";

  const tree = document.getElementById("tree")!;
  initAgentTree(tree, topics);
</script>

<!-- Global : les éléments SVG sont créés par le script, les styles scopés d'Astro ne les atteindraient pas. -->
<style is:global>
  .agent-tree {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .agent-tree .hint {
    margin: 0;
    font-family: var(--f-hand);
    font-size: 21px;
    color: var(--muted);
  }
  .agent-tree .hint span {
    color: var(--fg);
  }

  .agent-tree .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .agent-tree .chip {
    font: 500 15px/1.2 var(--f-ui);
    color: var(--fg);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 10px 16px 10px 12px;
    min-height: 44px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .agent-tree .chip:hover:not(:disabled) {
    border-color: var(--fg);
  }
  .agent-tree .chip[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .agent-tree .chip:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .agent-tree .swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--outline);
  }

  .agent-tree .play {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
  }
  .agent-tree .stage {
    position: relative;
    flex: 999 1 640px;
    min-width: 0;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--stage);
  }
  .agent-tree svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: manipulation;
  }
  .agent-tree canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .agent-tree .score {
    position: absolute;
    top: 12px;
    left: 12px;
    font: 500 12px/1 var(--f-mono);
    color: var(--muted);
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 7px 12px;
    font-variant-numeric: tabular-nums;
  }
  .agent-tree .score b {
    color: var(--fg);
    font-weight: 500;
  }

  /* Dessin SVG */
  .agent-tree .dot {
    fill: var(--dots);
  }
  .agent-tree .edge {
    fill: none;
    stroke: var(--edge);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .agent-tree .edge.on {
    stroke: var(--fg);
    stroke-dasharray: 5 6;
    animation: edge-flow 0.45s linear infinite;
  }
  @keyframes edge-flow {
    to {
      stroke-dashoffset: -22;
    }
  }
  .agent-tree .agent {
    cursor: pointer;
  }
  .agent-tree .agent.sub {
    cursor: default;
  }
  .agent-tree .ol {
    stroke: var(--outline);
    stroke-width: 2.2;
  }
  .agent-tree .ol.thin {
    stroke-width: 1.5;
  }
  .agent-tree .legs {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .agent-tree .shadow {
    fill: var(--fg);
    opacity: 0.1;
  }
  .agent-tree .eye {
    fill: #fff;
    stroke: #15181c;
    stroke-width: 1.5;
  }
  .agent-tree .pupil {
    fill: #15181c;
  }
  .agent-tree .mouth {
    fill: none;
    stroke: #15181c;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .agent-tree .mouth.light {
    stroke: #fff;
  }
  .agent-tree .headset {
    fill: none;
    stroke: var(--fg);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .agent-tree .pending {
    fill: var(--accent);
  }
  .agent-tree .done-badge {
    fill: var(--c-stack);
  }
  .agent-tree .tick {
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .agent-tree .label {
    font: 500 14px var(--f-mono);
    fill: var(--fg);
    text-anchor: middle;
  }
  .agent-tree .status {
    font: 12px var(--f-mono);
    fill: var(--muted);
    text-anchor: middle;
  }
  .agent-tree .sub .label {
    font-size: 13px;
  }
  .agent-tree .sub .status {
    font-size: 11px;
  }
  .agent-tree .bubble rect,
  .agent-tree .bubble path {
    fill: var(--card);
    stroke: var(--outline);
    stroke-width: 1.5;
  }
  .agent-tree .bubble text {
    font: 19px var(--f-hand);
    fill: var(--fg);
  }
  .agent-tree .packet rect {
    stroke: var(--outline);
    stroke-width: 1.6;
  }

  /* Réponse et trace */
  .agent-tree .side {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .agent-tree .answer {
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 22px 24px 26px;
    min-width: 0;
  }
  .agent-tree .answer h2 {
    margin: 0 0 4px;
    font-weight: 800;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .agent-tree .answer .by {
    margin: 0 0 16px;
    font: 12px/1.5 var(--f-mono);
    color: var(--muted);
  }
  .agent-tree .answer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .agent-tree .answer li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    animation: answer-rise 0.35s ease-out both;
  }
  .agent-tree .answer li span {
    color: var(--muted);
    font-size: 15px;
  }
  .agent-tree .answer li span strong {
    color: var(--fg);
    font-weight: 500;
  }
  .agent-tree .answer p {
    margin: 0 0 12px;
    max-width: 62ch;
  }
  .agent-tree .answer a {
    color: var(--fg);
  }
  @keyframes answer-rise {
    from {
      opacity: 0.2;
      transform: translateY(6px);
    }
  }
  .agent-tree .waiting {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .agent-tree .waiting span {
    height: 12px;
    border-radius: 6px;
    background: var(--line);
    animation: waiting-pulse 0.9s ease-in-out infinite alternate;
  }
  .agent-tree .waiting span:nth-child(2) {
    width: 82%;
  }
  .agent-tree .waiting span:nth-child(3) {
    width: 58%;
  }
  @keyframes waiting-pulse {
    to {
      opacity: 0.35;
    }
  }
  .agent-tree .trace {
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 14px 16px;
    min-width: 0;
  }
  .agent-tree .trace h3 {
    margin: 0 0 8px;
    font: 500 11px/1 var(--f-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .agent-tree .trace ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font: 12px/1.65 var(--f-mono);
    color: var(--muted);
    max-height: 220px;
    overflow: auto;
  }
  .agent-tree .trace b {
    color: var(--fg);
    font-weight: 500;
  }
  .agent-tree .trace li.done {
    color: var(--fg);
  }
  .agent-tree .note {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
</style>
