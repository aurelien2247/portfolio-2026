---
import "../styles/global.css";
import photo from "../assets/aurelien.jpg";
import { GITHUB, LINKEDIN } from "../data/agents";
import { HOME, LANGS, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;

// Google veut des adresses complètes pour les versions de langue : elles partent de `site`
// (astro.config.mjs). Tant qu'il n'est pas renseigné, on garde des chemins relatifs.
const url = (l: Lang) => (Astro.site ? new URL(HOME[l], Astro.site).href : HOME[l]);

// Ma « carte de visite » pour les moteurs de recherche : relie mon nom à ce site et à mes profils.
const person = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Aurélien Moignet",
  url: url("fr"),
  image: new URL(photo.src, Astro.site ?? Astro.url).href,
  jobTitle: ui[lang].role.replace(/\.$/, ""),
  sameAs: [LINKEDIN, GITHUB],
});
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Première visite : on suit la langue du navigateur (français, sinon anglais).
         Dès qu'on clique sur FR ou EN, ce choix est retenu et passe avant.
         On ne redirige jamais : quand on arrive d'une autre page du site (on vient de choisir la langue,
         même si le navigateur n'a pas pu la retenir), ni les robots des moteurs de recherche, qui
         doivent pouvoir lire les deux versions.
         Ce script tourne avant l'affichage : il choisit aussi la vue à montrer. -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("lang");
        } catch {}
        if (saved !== "fr" && saved !== "en") saved = null;
        const browser = (navigator.languages?.[0] || navigator.language || "").toLowerCase();
        const want = saved || (browser.startsWith("fr") ? "fr" : "en");
        const fromSite = document.referrer.startsWith(location.origin + "/");
        const robot = /bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent);
        if (want !== document.documentElement.lang && !fromSite && !robot) {
          location.replace(want === "en" ? "/en/" : "/");
          return;
        }
        // Avant le premier affichage : l'arbre au lieu de la version rapide (voir Home.astro),
        // ou la version rapide si on l'avait ouverte avant de changer de langue
        const root = document.documentElement;
        root.classList.add("js");
        try {
          if (sessionStorage.getItem("quick") === "true") root.classList.add("show-quick");
          sessionStorage.removeItem("quick");
        } catch {}
      })();
    </script>
    <meta name="description" content={description} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={url(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={url("fr")} />
    {Astro.site && <link rel="canonical" href={url(lang)} />}
    <script type="application/ld+json" set:html={person} />
    <!-- L'aperçu quand on partage le lien (LinkedIn, WhatsApp, Slack…) : une capture de la page en pleine
         animation, dans la langue de la page. Sans elle, LinkedIn prenait la première image venue. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aurélien Moignet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:image" content={new URL(`/og-${lang}.jpg`, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui[lang].ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- L'icône de l'onglet : ma photo en rond ; en carré pour l'écran d'accueil d'un iPhone -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=Patrick+Hand&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
